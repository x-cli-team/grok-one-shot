#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/based/Documents/Github/grok-one-shot/packages/cli/dist/node_modules:/Users/based/Documents/Github/grok-one-shot/packages/cli/node_modules:/Users/based/Documents/Github/grok-one-shot/packages/node_modules:/Users/based/Documents/Github/grok-one-shot/node_modules:/Users/based/Documents/Github/node_modules:/Users/based/Documents/node_modules:/Users/based/node_modules:/Users/node_modules:/node_modules:/Users/based/Documents/Github/grok-one-shot/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/based/Documents/Github/grok-one-shot/packages/cli/dist/node_modules:/Users/based/Documents/Github/grok-one-shot/packages/cli/node_modules:/Users/based/Documents/Github/grok-one-shot/packages/node_modules:/Users/based/Documents/Github/grok-one-shot/node_modules:/Users/based/Documents/Github/node_modules:/Users/based/Documents/node_modules:/Users/based/node_modules:/Users/node_modules:/node_modules:/Users/based/Documents/Github/grok-one-shot/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@xagent/one-shot-cli/dist/index.js" "$@"
else
  exec node  "$basedir/../@xagent/one-shot-cli/dist/index.js" "$@"
fi
